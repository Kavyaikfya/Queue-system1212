# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# If DATABASE_URL is left unset or blank, the server automatically uses persistent embedded
# PostgreSQL via @electric-sql/pglite stored in ./server/data/postgres_db with zero setup!
# To connect to external PostgreSQL, uncomment and set the connection string:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/fair_queue_db

# JWT Authentication
JWT_SECRET=fair_queue_production_secret_key_2026_super_secure

# Socket.IO & CORS
CORS_ORIGIN=*
