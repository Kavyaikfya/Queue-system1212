# =======================================================
# QEVORA / REAL-TIME FAIR QUEUE SYSTEM - SERVER CONFIG
# =======================================================

# Port to bind (Render automatically provides PORT in production)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# JWT Authentication secret key
JWT_SECRET=fair_queue_production_secret_key_2026_super_secure

# Database Configuration:
# - Leave blank to use persistent embedded PostgreSQL (PGlite) automatically
# - Or provide an external PostgreSQL / Supabase connection URL:
# DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require

# CORS Configuration:
# - Set to '*' to allow all origins dynamically
# - Or set to your Vercel frontend URL: https://your-app.vercel.app
# - Multiple origins: https://your-app.vercel.app,http://localhost:5173
CORS_ORIGIN=*
